# =============================================
# HaemoLink Backend — Environment Variables
# =============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to version control.
# =============================================

# Server
PORT=5000

# JWT Authentication
# Use a long random string (min 32 chars) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_32_characters
JWT_EXPIRES_IN=8h

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=haemolink
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# CORS — URL of the frontend (e.g. http://localhost:3000 or https://yourapp.vercel.app)
CORS_ORIGIN=http://localhost:3000
